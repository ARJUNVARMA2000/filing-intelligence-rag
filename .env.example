# Runtime mode. AUTH_MODE=disabled is accepted only for local/development/test.
APP_ENV=local
AUTH_MODE=disabled

# Generation provider: openai or vertexai.
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Vertex AI (used when LLM_PROVIDER=vertexai).
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
VERTEX_CHAT_MODEL=gemini-2.5-flash

# Bounded provider behavior.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048

# Controlled multi-model evaluation only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Frontend-to-backend connection.
FIN_RAG_API_BASE=http://localhost:8000
FIN_RAG_AUTH_MODE=local
FRONTEND_URL=http://localhost:8501

# Production Google identity-token verification.
FRONTEND_SERVICE_ACCOUNT=
BACKEND_AUDIENCE=

# Optional source-document storage.
DOCUMENT_BUCKET=
DATA_DIR=

# Optional supported Quartr Public API synchronization.
QUARTR_API_KEY=
QUARTR_API_BASE_URL=https://api.quartr.com/public/v3
DATA_TICKERS=AAPL,ADS,AMZN,COST,IBM,JNJ,JPM,LOW,META,NFLX,NVDA,TGT,TSLA,V,WMT
DATA_MAX_AGE_HOURS=168
